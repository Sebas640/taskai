# Copia este archivo como backend/.env y rellena los valores. backend/.env NUNCA se sube al repositorio.

# API key de Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Conexión a PostgreSQL. Local:  postgresql://postgres:TU_PASSWORD@127.0.0.1:5432/taskai_db
# Neon (nube):                  postgresql://USUARIO:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clave para firmar los JWT de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
